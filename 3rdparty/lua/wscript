def options(opt):
	pass

def configure(conf):
	pass

def build(bld):
	bld.stlib(
		source = bld.path.ant_glob('src/*.c', excl = ['src/lua.c', 'src/luac.c', 'src/onelua.c', 'src/ltests.c']),
		target = 'lua',
		cflags = ['-w'],
		includes = 'src',
		export_includes = 'src'
	)
